# Root environment for docker compose (copy to .env and adjust).

# --- Ports exposed on the host ---
BACKEND_PORT=3001
FRONTEND_PORT=8080

# --- Frontend build-time config ---
# NOTE: this is embedded into the frontend bundle at build time.
# Use an address reachable from the browser, e.g. http://<lxc-ip>:3001
VITE_API_BASE_URL=http://localhost:3001

# --- Backend ---
# Origins allowed to call the API (comma-separated)
CORS_ORIGIN=http://localhost:8080

# --- MQTT broker ---
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=wavin-modern-backend
MQTT_BASE_TOPIC=wavin
