# Deployment overrides (copy to deploy/.env or the repository root .env).
# All values shown are the defaults; uncomment and change what you need.

# Ports exposed on the host
# BACKEND_PORT=3001
# FRONTEND_PORT=8080

# Frontend build-time API URL (address reachable from the browser)
# VITE_API_BASE_URL=http://localhost:3001

# Backend CORS allow-list (comma-separated)
# CORS_ORIGIN=http://localhost:8080

# MQTT broker connection
# MQTT_URL=mqtt://localhost:1883
# MQTT_USERNAME=
# MQTT_PASSWORD=
# MQTT_CLIENT_ID=wavin-modern-backend
# MQTT_BASE_TOPIC=wavin
