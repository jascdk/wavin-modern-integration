# Backend service configuration
NODE_ENV=development
PORT=3001
# Comma-separated list of origins allowed to call the API (the frontend origin)
CORS_ORIGIN=http://localhost:5173,http://localhost:8080

# MQTT broker connection
MQTT_URL=mqtt://localhost:1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=wavin-modern-backend
MQTT_BASE_TOPIC=wavin
